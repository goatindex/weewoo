{
  "name": "weewoo",
  "version": "1.0.0",
  "description": "Australian emergency services map",
  "scripts": {
    "start": "node serve.js",
    "test": "node --test \"test/**/*.test.js\"",
    "build": "node scripts/build.js",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npm run build && npx cap sync android && npx cap open android",
    "cap:ios": "npm run build && npx cap sync ios && npx cap open ios",
    "icons": "node scripts/generate-icons.js",
    "lint": "eslint .",
    "lint:docs": "vale --glob=\"!{node_modules,www,android,ios,.claude,.git,scripts}/**\" --output=line . && markdownlint-cli2"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "markdownlint-cli2": "^0.23.1",
    "sharp": "^0.34.5"
  }
}
